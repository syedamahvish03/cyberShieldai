
{
  "manifest_version": 3,
  "name": "CyberShield AI - Phishing Scanner",
  "version": "1.0.0",
  "description": "Scan selected email and SMS text for phishing threats.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberShield AI Scanner"
  }
}
