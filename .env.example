# Django
SECRET_KEY=replace_with_a_generated_secret_key

# Development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Production HTTPS settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Optional: comma-separated HTTPS origins
CSRF_TRUSTED_ORIGINS=
# Gmail API email delivery (never commit real values)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_SENDER_EMAIL=

# Gmail inbox monitoring (separate from the sender account)
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_MONITOR_SECRET=
